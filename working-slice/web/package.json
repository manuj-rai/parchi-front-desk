{
  "name": "parchi-front-desk-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/flatten-segments.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:live": "npm run build && cross-env PARCHI_E2E_LIVE=1 playwright test",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
}
