# Parchi UI: configuration (copy to .env.local; never commit it).
#
# Only needed for `npm run dev`. The built UI (npm run build) is served by the Python
# server itself and calls the API on the same address, so it needs nothing here.

# Where the Python API runs during development.
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8765

# For the browser tests: 1 runs them against live models from working-slice/.env.
# Prefer the npm scripts, which set this for you:  npm run test:e2e  /  npm run test:e2e:live
# PARCHI_E2E_LIVE=0
