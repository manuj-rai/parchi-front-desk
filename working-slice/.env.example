# Parchi working slice: configuration
#
# Copy to .env (never commit .env) and fill in what you need. Real environment variables
# override this file, which is how production and CI set them.
#
# Check what is in effect, with keys masked, at any time:
#     python -m parchi.settings
# The server refuses to start, with a clear message, if the settings are not valid.

# ---------------------------------------------------------------------------------------
# Provider keys. A provider is used only if its key is set; anything you leave blank is
# skipped and the next model in that job's list answers. OpenAI alone runs everything.
# ---------------------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEEPGRAM_API_KEY=

# ---------------------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------------------
# development | test | production. Production refuses offline test mode.
PARCHI_ENV=development
PARCHI_HOST=127.0.0.1
PARCHI_PORT=8765
# debug | info | warning | error
PARCHI_LOG_LEVEL=warning
# Browser origins allowed to call the API, comma-separated (the UI's dev server by default).
PARCHI_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# 1 = offline test mode: stand-in models with fixed answers. No keys, no cost.
PARCHI_FAKE_MODELS=0

# ---------------------------------------------------------------------------------------
# Product
# ---------------------------------------------------------------------------------------
# Which clinic this server answers for: a file in clinics/ (general-physician, dental, ent).
# It holds the clinic's facts, what its doctor treats, and the doctor's urgency rules.
# The doctor changes these on the dashboard (Clinic settings); the changes are kept in
# PARCHI_DATA_DIR/clinic-settings/ and laid over the file, which itself is never edited.
PARCHI_CLINIC=general-physician
# Callers who heard more than this much silence hung up three times as often [H4].
PARCHI_SILENCE_LIMIT_S=2.0
# Below this, the front-desk agent's reading counts as unsure: ask once, then a person.
PARCHI_CONFIDENCE_FLOOR=0.6
PARCHI_TTS_VOICE=coral
# Language hint for OpenAI speech to text. "hi" keeps Hindi in Devanagari (without it, some
# transcripts came back in Urdu script). Leave empty to let the model detect the language.
PARCHI_STT_LANGUAGE=hi

# ---------------------------------------------------------------------------------------
# The call log and staff access (the dashboard at /dashboard/)
# ---------------------------------------------------------------------------------------
# Where calls, transcripts, recordings, appointments and the doctor's clinic settings are kept
# (SQLite, audio files, JSON). Never commit it.
# Default: working-slice/data. In PARCHI_ENV=test it is always a fresh temporary folder.
# PARCHI_DATA_DIR=data
# Calls, recordings and appointments older than this many days are deleted when the server starts.
PARCHI_RETENTION_DAYS=90
# The clinic's time zone, as minutes ahead of UTC (India: 330). Decides "today", "yesterday", and when
# the token board starts a new day.
PARCHI_CLINIC_UTC_OFFSET_MINUTES=330
# Largest recorded caller turn accepted, in MB.
PARCHI_MAX_UPLOAD_MB=5
# How long a staff sign-in lasts, in hours.
PARCHI_SESSION_HOURS=12
# Staff passwords, as hashes only. Make one with:  python -m parchi.auth hash
# The doctor's is required in production. Leave the receptionist's empty to disable that sign-in.
PARCHI_DOCTOR_PASSWORD_HASH=
PARCHI_RECEPTION_PASSWORD_HASH=
# 1 = test sign-ins: doctor / doctor-test and reception / reception-test. Always on in offline
# test mode (PARCHI_FAKE_MODELS=1). Refused in production.
PARCHI_DEMO_LOGINS=0

# ---------------------------------------------------------------------------------------
# Model routing: which models do each job, in order of preference, as provider:model.
# Providers: openai, anthropic, google (agents); deepgram, openai (speech to text).
# If a model fails or passes its time limit, the next one answers.
# Chosen by measurement: python evaluate_agents.py --model provider:model (results in evaluation/logs/).
# ---------------------------------------------------------------------------------------
PARCHI_MODELS_FRONT_DESK=openai:gpt-5.4-mini,anthropic:claude-haiku-5-5,openai:gpt-4.1-mini
PARCHI_MODELS_SAFETY=openai:gpt-4.1-mini,anthropic:claude-haiku-5-5,openai:gpt-5.4-mini
PARCHI_MODELS_STT=deepgram:nova-3,openai:gpt-4o-mini-transcribe
PARCHI_MODELS_TTS=openai:gpt-4o-mini-tts
# Time limit for one attempt, in seconds, before falling back to the next model.
PARCHI_TIMEOUT_AGENT_S=5
PARCHI_TIMEOUT_STT_S=5
PARCHI_TIMEOUT_TTS_S=8
